# The FreePascal compiler DRL's port is built with (scripts/ensure-fpc.sh).
# Kept here rather than in tools/toolchain.env, which every game's runtime
# cache key hashes: only DRL uses it. Changing a value is a deliberate,
# reviewed update: rebuild DRL and run its conformance tests.
#
# FreePascal's WebAssembly targets (wasm32-wasip1) are only in its development
# branch (3.3.1); there is no release with them. An exact commit of it, with
# patches/fpc/*.patch applied, built from source.
FPC_REPO=https://gitlab.com/freepascal.org/fpc/source.git
FPC_COMMIT=128a07af7c265f9303a46257a1b411a04920dba5
FPC_VERSION=3.3.1
# Building it needs a released FreePascal (3.2.x) to start from: the
# distribution's fpc package (Ubuntu 24.04: 3.2.2). The compiler then rebuilds
# itself (make cycle) and the result does not depend on it.
FPC_BOOTSTRAP_VERSIONS="3.2.2 3.2.4"
