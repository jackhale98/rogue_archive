# Pinned upstream sources for the DRL port. Update deliberately; see
# docs/contributing/updating-a-game.md.
#
# DRL and FPC Valkyrie (ChaosForge's engine library) are released together,
# with matching tags (upstream's README: keep both on the same release).
UPSTREAM_REPO=https://github.com/chaosforgeorg/drl
UPSTREAM_TAG=0_10_12c
UPSTREAM_COMMIT=501db3060829e89610f5880079e0d5791df6999a
UPSTREAM_VERSION=0.10.12c
VALKYRIE_REPO=https://github.com/chaosforgeorg/fpcvalkyrie
VALKYRIE_TAG=0_10_12
VALKYRIE_COMMIT=effea5628a3c96c21aa7e8b0663dff080e56b116
# DRL needs Lua 5.1 (upstream's README); 5.1.5 is the last 5.1 release.
LUA_URL=https://www.lua.org/ftp/lua-5.1.5.tar.gz
LUA_SHA256=2640fc56a795f29d28ef15e13c34a47e223960b0240e8cb0a82d9b0738695333
LUA_VERSION=5.1.5
# The graphical (tiles) build: SDL3_image, which Valkyrie loads at run time
# for PNG images (vglimage.pas), built from source for WebAssembly: the
# release upstream ships in ext/linux (libSDL3_image.so.0.4.0). SDL 3 itself
# is Emscripten's port (scripts/ports.sh): 3.4.2, as upstream's
# ext/linux/libSDL3.so.0.4.2.
SDL_IMAGE_REPO=https://github.com/libsdl-org/SDL_image
SDL_IMAGE_TAG=release-3.4.0
SDL_IMAGE_COMMIT=ad58ecfc27a1bd09e510ceff8bbbdb1094806476
