# Pinned upstream source for the Dungeon Crawl Stone Soup port. Update
# deliberately; see docs/contributing/updating-a-game.md.
UPSTREAM_REPO=https://github.com/crawl/crawl
UPSTREAM_TAG=0.34.1
UPSTREAM_COMMIT=1eebc1a2892e1c89776a0d7a10691f8dac8d9796
UPSTREAM_VERSION=0.34.1
# Upstream git submodules the build needs (the rest are SDL/local-tiles only;
# fonts is only read for the license embedded in the DejaVu fonts).
UPSTREAM_SUBMODULES="crawl-ref/source/contrib/lua crawl-ref/source/contrib/sqlite crawl-ref/source/contrib/zlib crawl-ref/source/contrib/pcre crawl-ref/source/contrib/fonts"
