# Pinned upstream source for the Rogue port: the redistributable Rogue 5.4.4
# source release (Roguelike Restoration Project, BSD-3-Clause), mirrored on
# GitHub. Update deliberately; see docs/contributing/updating-a-game.md.
UPSTREAM_REPO=https://github.com/Davidslv/rogue
UPSTREAM_TAG=5.4.4
UPSTREAM_COMMIT=cf9bd26d564a72fac4cf56b55c96c2435270d29a
UPSTREAM_VERSION=5.4.4
# Tiles for Display: Tiles: the CC0 export of Dungeon Crawl Stone Soup's tiles
# (based on the public-domain RLTiles). tiles/tiles.json lists the files used.
TILES_REPO=https://github.com/crawl/tiles
TILES_COMMIT=a6ea1655db5c044829d9eea19a232fa6fcac87b0
TILES_RELEASE=releases/Nov-2015
# Tiles for Display: 1-Bit: Kenney's 1-Bit Pack (CC0), as published on
# OpenGameArt, verified by SHA-256. Only its tile sheet and licence are shipped;
# tiles/one-bit.json maps symbols to tiles in the sheet.
ONEBIT_URL=https://opengameart.org/sites/default/files/1bitpack_kenney_1.1.zip
ONEBIT_SHA256=7ca44530b7e04ec06c63fcd90a14fe60ce5a1f998a41f33e7408e57226570d8e
ONEBIT_VERSION=1.1
ONEBIT_SHEET=Tilesheet/colored_transparent_packed.png
