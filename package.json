{
  "name": "rogue-archive",
  "private": true,
  "description": "A curated, static, local-first library of classic roguelikes playable in the browser.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @rogue-archive/web dev",
    "build": "pnpm validate:catalog && pnpm stage:runtimes && pnpm --filter @rogue-archive/web build",
    "preview": "pnpm --filter @rogue-archive/web preview",
    "build:dcss": "bash games/dcss/scripts/build.sh",
    "test:engine:dcss": "bash games/dcss/scripts/test-engine.sh",
    "test:engine:sil": "bash games/sil-q/scripts/test-engine.sh",
    "test:engine:rogue": "bash games/rogue/scripts/test-engine.sh",
    "build:brogue": "games/brogue-ce/scripts/build.sh",
    "build:sil": "bash games/sil-q/scripts/build.sh",
    "build:rogue": "bash games/rogue/scripts/build.sh",
    "stage:runtimes": "node tools/stage-runtimes.mjs",
    "validate:catalog": "node --experimental-strip-types tools/validate-catalog.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:engine": "games/brogue-ce/scripts/test-engine.sh",
    "canary:dcss": "ROGUE_ARCHIVE_UPSTREAM_REF=${ROGUE_ARCHIVE_UPSTREAM_REF:-latest-release} sh -c \"games/dcss/scripts/build.sh && games/dcss/scripts/test-engine.sh\"",
    "canary:brogue": "ROGUE_ARCHIVE_UPSTREAM_REF=${ROGUE_ARCHIVE_UPSTREAM_REF:-latest-release} sh -c \"games/brogue-ce/scripts/build.sh && games/brogue-ce/scripts/test-engine.sh\"",
    "canary:sil": "ROGUE_ARCHIVE_UPSTREAM_REF=${ROGUE_ARCHIVE_UPSTREAM_REF:-latest-release} sh -c \"games/sil-q/scripts/build.sh && games/sil-q/scripts/test-engine.sh\"",
    "canary:rogue": "ROGUE_ARCHIVE_UPSTREAM_REF=${ROGUE_ARCHIVE_UPSTREAM_REF:-latest-release} sh -c \"games/rogue/scripts/build.sh && games/rogue/scripts/test-engine.sh\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
